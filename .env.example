# ── Docs Editor: developer overrides (optional) ─────────────
# End users never need this file. The app ships preconfigured with
# the team's document libraries and signs people in via GitHub —
# a fresh install works with zero configuration.
#
# A .env next to the app (repo root in dev) overrides the baked-in
# defaults; a real process env var overrides the .env. All values
# optional.

# Point at a different library
#REPO_OWNER=cirdia-wellness
#REPO_NAME=cirdia-documentation
#DEFAULT_BRANCH=main

# Extra libraries for the footer switcher (owner/repo[@branch], comma-separated)
#REPOS=marycamacho/writing

# Only show one folder of the repo / change the session-branch prefix
#DOCS_ROOT=docs
#BRANCH_PREFIX=docs/

# Pre-set the name shown in edit history (otherwise asked at first run)
#DISPLAY_NAME=Mary

# Bypass sign-in with a raw token (dev), or test another GitHub App
#GITHUB_TOKEN=github_pat_...
#GITHUB_APP_CLIENT_ID=Iv...
